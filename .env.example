# Clave de Google AI Studio para Gemini (genera nombres de búsqueda).
# Consíguela en https://aistudio.google.com/apikey y cópiala en tu .env local.
# Sin clave la app sigue funcionando con términos automáticos (fallback).
GEMINI_API_KEY=

# Modelo opcional (por defecto gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# Tiempo máximo por petición a Gemini, en milisegundos (por defecto 20000)
# GEMINI_TIMEOUT_MS=20000

# Reintentos ante 429/5xx de Gemini (por defecto 2)
# GEMINI_MAX_RETRIES=2

# Puerto del servidor web
PORT=3000

# Interfaz de escucha.
# - 127.0.0.1: solo en tu equipo (recomendado en local)
# - 0.0.0.0: accesible desde internet (producción / Contabo)
HOST=127.0.0.1
